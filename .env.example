# LLM provider — any OpenAI-compatible endpoint works.
# Default points at Groq (free tier, no card required: https://console.groq.com).
# Leave LLM_API_KEY empty to run with a deterministic mock classifier.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Telegram notification — optional.
# If either is empty, the pipeline still works; notify just logs and returns.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite file location.
DB_PATH=leads.db
