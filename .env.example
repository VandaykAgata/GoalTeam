# LLM provider. Any OpenAI-compatible endpoint works.
# Default points at Groq (free tier, no card): https://console.groq.com
# Leave LLM_API_KEY empty to run the deterministic mock classifier.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Telegram notification. Optional: empty token or chat_id => notification skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite file location.
DB_PATH=leads.db
